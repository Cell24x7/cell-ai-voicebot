# Cell AI Voicebot — frontend environment variables
# Copy to `.env.local` for local development (gitignored).
# ⚠️ VITE_* variables browser bundle me PUBLIC hote hain — inme kabhi secret mat daalna.

# API base path. Default goes through the Vite dev proxy (/api → http://localhost:5100).
VITE_API_URL=/api/v1
# WebSocket BASE URL (proxied /ws → backend on :5100); the client appends /events?ticket=….
# Empty = derived from the page origin (ws:// or wss:// + host + /ws).
VITE_WS_URL=ws://localhost:3100/ws
VITE_APP_NAME=Cell AI Voicebot

# Phase 13 — public company details for /privacy, /terms, /contact and /data-deletion
# (PUBLIC values; a missing one shows as [name] with a Draft banner)
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_GRIEVANCE_OFFICER=
VITE_LEGAL_WEBSITE=
